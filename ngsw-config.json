{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/__/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "!/assets/wrapped/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "f3-api",
      "urls": [
        "https://f3-scraper-rs.fly.dev/**",
        "https://api.f3nation.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "10s",
        "maxAge": "7d",
        "maxSize": 200
      }
    },
    {
      "name": "ionicons",
      "urls": [
        "/svg/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "30d",
        "maxSize": 400
      }
    }
  ]
}
